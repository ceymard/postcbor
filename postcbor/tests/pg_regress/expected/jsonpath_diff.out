(155, 'query', $q$select
	x, y,
	jsonb_path_query(('[true, false, null]'::cbor)::jsonb,
		'$[*] ? (@ == true  &&  ($x == true && $y == true) ||
				 @ == false && !($x == true && $y == true) ||
				 @ == null  &&  ($x == true && $y == true) is unknown)',
		jsonb_build_object('x', x, 'y', y)
	) as "x && y"
from
	(values (('true'::cbor)::jsonb), ('false'), ('"null"')) x(x),
	(values (('true'::cbor)::jsonb), ('false'), ('"null"')) y(y)$q$, $q$select
	x, y,
	cbor_path_query(
		'[true, false, null]',
		'$[*] ? (@ == true  &&  ($x == true && $y == true) ||
				 @ == false && !($x == true && $y == true) ||
				 @ == null  &&  ($x == true && $y == true) is unknown)',
		cbor_build_object('x', x, 'y', y)
	) as "x && y"
from
	(values (cbor 'true'), ('false'), ('"null"')) x(x),
	(values (cbor 'true'), ('false'), ('"null"')) y(y)$q$),
(156, 'query', $q$select
	x, y,
	jsonb_path_query(('[true, false, null]'::cbor)::jsonb,
		'$[*] ? (@ == true  &&  ($x == true || $y == true) ||
				 @ == false && !($x == true || $y == true) ||
				 @ == null  &&  ($x == true || $y == true) is unknown)',
		jsonb_build_object('x', x, 'y', y)
	) as "x || y"
from
	(values (('true'::cbor)::jsonb), ('false'), ('"null"')) x(x),
	(values (('true'::cbor)::jsonb), ('false'), ('"null"')) y(y)$q$, $q$select
	x, y,
	cbor_path_query(
		'[true, false, null]',
		'$[*] ? (@ == true  &&  ($x == true || $y == true) ||
				 @ == false && !($x == true || $y == true) ||
				 @ == null  &&  ($x == true || $y == true) is unknown)',
		cbor_build_object('x', x, 'y', y)
	) as "x || y"
from
	(values (cbor 'true'), ('false'), ('"null"')) x(x),
	(values (cbor 'true'), ('false'), ('"null"')) y(y)$q$),

-- PostgreSQL's jsonb jsonpath tests run against cbor (generated by tests/jsonpath/extract_cases.py).
-- Only statements whose cbor results differ from jsonb's print.
CREATE TEMP TABLE path_cases (n int, kind text, j text, c text);
